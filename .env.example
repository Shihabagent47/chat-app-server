# Database Configuration
# When running locally: DB_HOST=localhost
# When running with Docker Compose, DB_HOST is overridden to "db" automatically
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=chat-app

# Environment
NODE_ENV=development
PORT=3000
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=1d
